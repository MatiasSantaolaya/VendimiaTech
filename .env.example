DATABASE_URL="postgresql://postgres:postgres@localhost:5432/plane"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Abra Tickets: the public checkout can be embedded without API credentials.
# Fill these only when Abra provides an API/webhook contract to the organizer.
ABRA_API_BASE_URL=
ABRA_API_KEY=
ABRA_WEBHOOK_SECRET=

# Provider-neutral transactional email endpoint
EMAIL_API_BASE_URL=
EMAIL_API_KEY=
EMAIL_FROM="PlanE <noreply@plane.events>"

# Provider-neutral S3-compatible presigning service
STORAGE_SIGNING_URL=
STORAGE_API_KEY=

# Provider-neutral payment adapter (not required when Abra handles ticket sales)
PAYMENT_PROVIDER_NAME=
PAYMENT_API_BASE_URL=
PAYMENT_API_KEY=
PAYMENT_WEBHOOK_SECRET=

# Provider-neutral AI adapter. Leave unset to use PlanE rule-engine responses.
AI_API_BASE_URL=
AI_API_KEY=
AI_MODEL=

# Worker auth
WORKER_SECRET=

# Optional. Unset means the in-memory limiter and console monitoring.
# RATE_LIMIT_DRIVER=upstash also needs the two Upstash variables.
RATE_LIMIT_DRIVER=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
MONITORING_DRIVER=
MONITORING_WEBHOOK_URL=

# Production seed (prisma/seed.ts). If these are empty the seed is a no-op.
# It does not load the Vendimia Tech demo graph.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ORG_NAME=
SEED_ADMIN_NAME=
